    <title>AI S.A.S. - Layout Optimizer</title>
    <!-- Tailwind CSS para diseño rápido y responsivo -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Personalización de la barra de desplazamiento para el tema oscuro */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0b1120;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #38bdf8;
        }
        /* Transiciones suaves */
        .input-trans {
            transition: all 0.2s ease-in-out;
        }
    </style>
</head>
<body class="bg-[#0b1120] text-slate-300 font-sans min-h-screen flex flex-col">

    <!-- Header Corporativo -->
    <header class="bg-[#1e293b] border-b border-[#38bdf8] p-4 shadow-md flex items-center justify-between sticky top-0 z-50">
        <div class="flex items-center gap-4">
            <!-- Usamos el logo blanco para que contraste con el fondo oscuro -->
            <img src="image_5f6f26.jpg" alt="AI S.A.S. Logo" class="h-12 w-12 rounded-full border-2 border-[#38bdf8] object-cover" onerror="this.src='https://placehold.co/100x100/1e293b/38bdf8?text=AI'">
            <div>
                <h1 class="text-xl md:text-2xl font-bold text-white tracking-wide">AUTOMATION INSIGHTS S.A.S.</h1>
                <p class="text-[#38bdf8] text-sm md:text-base font-semibold tracking-wider">LAYOUT OPTIMIZER (GUERCHET & FACTOR MAQUINARIA)</p>
            </div>
        </div>
        <div>
            <button id="btn-medivalle" class="bg-[#38bdf8] hover:bg-sky-400 text-[#0b1120] font-bold py-2 px-4 rounded shadow-[0_0_10px_rgba(56,189,248,0.4)] transition-all flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M11.3 1.046A12.014 12.014 0 0010 1a11.996 11.996 0 00-8.03 3.015l-.048.044A1 1 0 002 4.802v.006c0 1.258.113 2.492.33 3.693.208 1.15.53 2.26 1.01 3.298a12.18 12.18 0 004.814 5.378l.216.126a1 1 0 001.26 0l.216-.126a12.18 12.18 0 004.814-5.378c.48-1.037.802-2.148 1.01-3.298.217-1.2.33-2.435.33-3.693v-.006a1 1 0 00-.092-.741 12.014 12.014 0 00-4.634-2.99zM10 5a2 2 0 100 4 2 2 0 000-4z" clip-rule="evenodd" />
                </svg>
                Cargar Caso Medivalle
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow p-4 md:p-6 container mx-auto max-w-7xl">
        
        <!-- Panel 1: Variables Globales -->
        <section class="bg-[#1e293b] rounded-lg p-5 mb-6 shadow-lg border border-slate-700">
            <h2 class="text-lg text-[#38bdf8] font-semibold mb-4 border-b border-slate-700 pb-2">Parámetros Globales de Producción</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
                
                <div class="flex flex-col">
                    <label class="text-xs text-slate-400 mb-1">Demanda Anual (Unds)</label>
                    <input type="number" id="g-demanda" class="input-trans bg-slate-800 text-white px-3 py-2 rounded border border-slate-600 focus:border-[#38bdf8] focus:outline-none" value="100000" min="0">
                </div>
                
                <div class="flex flex-col">
                    <label class="text-xs text-slate-400 mb-1">Días Laborales/Año</label>
                    <input type="number" id="g-dias" class="input-trans bg-slate-800 text-white px-3 py-2 rounded border border-slate-600 focus:border-[#38bdf8] focus:outline-none" value="250" min="1">
                </div>
                
                <div class="flex flex-col">
                    <label class="text-xs text-slate-400 mb-1">Turnos por Día</label>
                    <input type="number" id="g-turnos" class="input-trans bg-slate-800 text-white px-3 py-2 rounded border border-slate-600 focus:border-[#38bdf8] focus:outline-none" value="2" min="1">
                </div>
                
                <div class="flex flex-col">
                    <label class="text-xs text-slate-400 mb-1">Horas por Turno</label>
                    <input type="number" id="g-horas" class="input-trans bg-slate-800 text-white px-3 py-2 rounded border border-slate-600 focus:border-[#38bdf8] focus:outline-none" value="8" min="1">
                </div>

                <div class="flex flex-col bg-slate-800/50 p-2 rounded border border-[#38bdf8]/30">
                    <label class="text-xs text-[#38bdf8] mb-1 font-semibold uppercase">Horas Totales Disponibles</label>
                    <div id="out-horas-totales" class="text-2xl text-white font-mono font-bold mt-auto">4000</div>
                </div>

            </div>
        </section>

        <!-- Panel 2: Máquinas y Cálculos (Tabla Dinámica) -->
        <section class="bg-[#1e293b] rounded-lg shadow-lg border border-slate-700 flex flex-col">
            <div class="p-4 border-b border-slate-700 flex justify-between items-center">
                <h2 class="text-lg text-[#38bdf8] font-semibold">Requerimiento de Maquinaria y Espacios</h2>
                <button id="btn-add-machine" class="bg-slate-700 hover:bg-slate-600 text-white text-sm py-1 px-3 rounded border border-slate-500 transition-colors flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#38bdf8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Agregar Máquina
                </button>
            </div>
            
            <div class="overflow-x-auto p-4">
                <table class="w-full text-left border-collapse min-w-[1000px]" id="machines-table">
                    <thead>
                        <tr class="text-xs text-slate-400 uppercase border-b border-slate-600">
                            <th class="pb-2 font-medium w-1/5">Equipo / Máquina</th>
                            <th class="pb-2 font-medium text-center">Largo (m)</th>
                            <th class="pb-2 font-medium text-center">Ancho (m)</th>
                            <th class="pb-2 font-medium text-center" title="Horas requeridas por unidad">Tiempo Est.(hr/ud)</th>
                            <th class="pb-2 font-medium text-center" title="Lados de operación/mantenimiento">Lados (N)</th>
                            <th class="pb-2 font-medium text-center" title="Coeficiente de industria">Coef. (K)</th>
                            <!-- Campos Calculados -->
                            <th class="pb-2 font-medium text-center text-[#38bdf8] border-l border-slate-700 pl-2">Máq. Req.</th>
                            <th class="pb-2 font-medium text-center text-sky-200">Se (m²)</th>
                            <th class="pb-2 font-medium text-center text-sky-200">Sg (m²)</th>
                            <th class="pb-2 font-medium text-center text-sky-200">Sc (m²)</th>
                            <th class="pb-2 font-medium text-center text-[#38bdf8]">Área Total</th>
                            <th class="pb-2"></th>
                        </tr>
                    </thead>
                    <tbody id="machines-tbody" class="text-sm">
                        <!-- Las filas se agregarán aquí dinámicamente -->
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <!-- Footer Flotante con Sumatoria Total -->
    <footer class="bg-[#0b1120] border-t-2 border-[#38bdf8] p-4 mt-auto">
        <div class="container mx-auto max-w-7xl flex flex-col md:flex-row justify-between items-center">
            <div class="text-slate-400 text-sm mb-2 md:mb-0">
                Modelo matemático: <span class="text-slate-300">Método de Guerchet & Factor Máquina</span>
            </div>
            <div class="flex items-center gap-4 bg-[#1e293b] px-6 py-3 rounded-lg shadow-[0_0_15px_rgba(56,189,248,0.2)] border border-slate-700">
                <span class="text-slate-300 font-semibold tracking-wide uppercase text-sm md:text-base">Área Total Estimada de Planta:</span>
                <span id="out-area-planta" class="text-2xl md:text-3xl font-mono font-bold text-[#38bdf8]">0.00 <span class="text-lg text-slate-400">m²</span></span>
            </div>
        </div>
    </footer>

    <!-- Script de Lógica -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Referencias del DOM Globales
            const gDemanda = document.getElementById('g-demanda');
            const gDias = document.getElementById('g-dias');
            const gTurnos = document.getElementById('g-turnos');
            const gHoras = document.getElementById('g-horas');
            const outHorasTotales = document.getElementById('out-horas-totales');
            
            const tbody = document.getElementById('machines-tbody');
            const outAreaPlanta = document.getElementById('out-area-planta');
            
            const btnAddMachine = document.getElementById('btn-add-machine');
            const btnMedivalle = document.getElementById('btn-medivalle');

            // Variables de estado
            let horasTotales = 4000;

            // Función para calcular Horas Totales Disponibles
            function calcHorasTotales() {
                const d = parseFloat(gDias.value) || 0;
                const t = parseFloat(gTurnos.value) || 0;
                const h = parseFloat(gHoras.value) || 0;
                horasTotales = d * t * h;
                outHorasTotales.textContent = horasTotales.toLocaleString('en-US');
            }

            // Función Principal de Cálculo de todo el Layout
            function calculateAll() {
                calcHorasTotales();
                const demanda = parseFloat(gDemanda.value) || 0;
                let areaPlantaTotal = 0;

                const rows = tbody.querySelectorAll('tr');
                rows.forEach(row => {
                    // Inputs
                    const inLargo = parseFloat(row.querySelector('.in-largo').value) || 0;
                    const inAncho = parseFloat(row.querySelector('.in-ancho').value) || 0;
                    const inTiempo = parseFloat(row.querySelector('.in-tiempo').value) || 0;
                    const inLados = parseFloat(row.querySelector('.in-lados').value) || 0;
                    const inK = parseFloat(row.querySelector('.in-k').value) || 0;

                    // Cálculos Factor Maquinaria
                    let maqRequeridas = 0;
                    if (horasTotales > 0) {
                        maqRequeridas = Math.ceil((inTiempo * demanda) / horasTotales);
                    }
                    
                    // Asegurar mínimo 1 máquina si hay tiempo definido (opcional, pero realista)
                    // Si se requieren cálculos puros matemáticos, dejamos el redondeo normal.
                    if (inTiempo > 0 && maqRequeridas === 0) maqRequeridas = 1; 

                    // Cálculos Guerchet
                    const se = inLargo * inAncho;
                    const sg = se * inLados;
                    const sc = (se + sg) * inK;
                    const areaTotalMaq = (se + sg + sc) * maqRequeridas;

                    // Actualizar Outputs en la fila
                    row.querySelector('.out-maq').textContent = maqRequeridas;
                    row.querySelector('.out-se').textContent = se.toFixed(2);
                    row.querySelector('.out-sg').textContent = sg.toFixed(2);
                    row.querySelector('.out-sc').textContent = sc.toFixed(2);
                    row.querySelector('.out-total').textContent = areaTotalMaq.toFixed(2);

                    // Acumular
                    areaPlantaTotal += areaTotalMaq;
                });

                // Actualizar Footer
                outAreaPlanta.innerHTML = `${areaPlantaTotal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} <span class="text-lg text-slate-400">m²</span>`;
            }

            // Función para agregar una nueva fila a la tabla
            function addMachineRow(data = {}) {
                const tr = document.createElement('tr');
                tr.className = 'border-b border-slate-700/50 hover:bg-slate-800/30 transition-colors group';
                
                tr.innerHTML = `
                    <td class="py-3 pr-2">
                        <input type="text" class="w-full input-trans bg-slate-800 text-white px-2 py-1.5 rounded border border-slate-600 focus:border-[#38bdf8] focus:outline-none placeholder-slate-500" placeholder="Nombre Equipo" value="${data.nombre || ''}">
                    </td>
                    <td class="py-3 px-1">
                        <input type="number" class="in-largo w-full input-trans bg-slate-800 text-white px-2 py-1.5 rounded border border-slate-600 focus:border-[#38bdf8] focus:outline-none text-center" min="0" step="0.1" value="${data.largo || 0}">
                    </td>
                    <td class="py-3 px-1">
                        <input type="number" class="in-ancho w-full input-trans bg-slate-800 text-white px-2 py-1.5 rounded border border-slate-600 focus:border-[#38bdf8] focus:outline-none text-center" min="0" step="0.1" value="${data.ancho || 0}">
                    </td>
                    <td class="py-3 px-1">
                        <input type="number" class="in-tiempo w-full input-trans bg-slate-800 text-white px-2 py-1.5 rounded border border-slate-600 focus:border-[#38bdf8] focus:outline-none text-center" min="0" step="0.001" value="${data.tiempo || 0}">
                    </td>
                    <td class="py-3 px-1">
                        <input type="number" class="in-lados w-full input-trans bg-slate-800 text-white px-2 py-1.5 rounded border border-slate-600 focus:border-[#38bdf8] focus:outline-none text-center" min="0" step="1" value="${data.lados || 1}">
                    </td>
                    <td class="py-3 px-1 pr-3">
                        <input type="number" class="in-k w-full input-trans bg-slate-800 text-white px-2 py-1.5 rounded border border-slate-600 focus:border-[#38bdf8] focus:outline-none text-center" min="0" step="0.1" value="${data.k || 1.5}">
                    </td>
                    
                    <!-- Outputs (Read Only) -->
                    <td class="py-3 px-2 border-l border-slate-700 pl-3">
                        <div class="out-maq w-full bg-slate-900 text-[#38bdf8] px-2 py-1.5 rounded font-mono font-bold text-center border border-slate-800">0</div>
                    </td>
                    <td class="py-3 px-1">
                        <div class="out-se w-full bg-[#111827] text-slate-400 px-2 py-1.5 rounded font-mono text-right border border-slate-800">0.00</div>
                    </td>
                    <td class="py-3 px-1">
                        <div class="out-sg w-full bg-[#111827] text-slate-400 px-2 py-1.5 rounded font-mono text-right border border-slate-800">0.00</div>
                    </td>
                    <td class="py-3 px-1">
                        <div class="out-sc w-full bg-[#111827] text-slate-400 px-2 py-1.5 rounded font-mono text-right border border-slate-800">0.00</div>
                    </td>
                    <td class="py-3 px-1">
                        <div class="out-total w-full bg-slate-900 text-[#38bdf8] px-2 py-1.5 rounded font-mono font-bold text-right border border-slate-800 shadow-[inset_0_1px_3px_rgba(0,0,0,0.5)]">0.00</div>
                    </td>
                    
                    <!-- Delete Button -->
                    <td class="py-3 pl-2 text-center">
                        <button class="btn-delete text-slate-500 hover:text-red-400 transition-colors opacity-0 group-hover:opacity-100 p-1" title="Eliminar Máquina">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                        </button>
                    </td>
                `;

                tbody.appendChild(tr);
                calculateAll();
            }

            // Botón Caso Medivalle (Dermazinc)
            btnMedivalle.addEventListener('click', () => {
                // Auto-llenar parámetros globales
                gDemanda.value = 150000; // Unidades/año (Dermazinc)
                gDias.value = 240;
                gTurnos.value = 2;
                gHoras.value = 8;
                
                // Limpiar tabla actual
                tbody.innerHTML = '';

                // Agregar máquinas de proceso cosmético/farmacéutico
                addMachineRow({nombre: 'Reactor de Mezcla 500L', largo: 2.5, ancho: 2.5, tiempo: 0.015, lados: 3, k: 2.0}); // Farmacéutico K=2.0
                addMachineRow({nombre: 'Envasadora Neumática', largo: 1.8, ancho: 1.2, tiempo: 0.008, lados: 2, k: 2.0});
                addMachineRow({nombre: 'Etiquetadora Automática', largo: 2.0, ancho: 1.0, tiempo: 0.005, lados: 2, k: 2.0});
                addMachineRow({nombre: 'Banda Acumulación/Embalaje', largo: 3.5, ancho: 1.5, tiempo: 0.01, lados: 1, k: 2.0});

                calculateAll();
            });

            // Event Listeners Globales
            [gDemanda, gDias, gTurnos, gHoras].forEach(input => {
                input.addEventListener('input', calculateAll);
            });

            // Event Delegation para inputs de la tabla y botón eliminar
            tbody.addEventListener('input', (e) => {
                if(e.target.tagName === 'INPUT') {
                    calculateAll();
                }
            });

            tbody.addEventListener('click', (e) => {
                if (e.target.classList.contains('btn-delete') || e.target.closest('.btn-delete')) {
                    const row = e.target.closest('tr');
                    row.remove();
                    calculateAll();
                }
            });

            btnAddMachine.addEventListener('click', () => {
                addMachineRow({nombre: '', largo: 0, ancho: 0, tiempo: 0, lados: 1, k: 1.5});
            });

            // Inicializar con una fila vacía
            addMachineRow({nombre: 'Máquina CNC Prensado', largo: 2.5, ancho: 2.0, tiempo: 0.025, lados: 2, k: 1.5});
            calculateAll();
        });
    </script>
</body>
</html>
